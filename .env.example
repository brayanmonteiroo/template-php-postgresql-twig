APP_ENV=development
APP_DEBUG=1
APP_URL=http://localhost:8080
APP_KEY=

# Com Docker Compose, DB_HOST=db e a senha vem de db/password.txt
# via DB_PASSWORD_FILE=/run/secrets/db-password (não precisa DB_PASSWORD).
DB_HOST=db
DB_PORT=5432
DB_NAME=template_admin
DB_USER=postgres
DB_PASSWORD=postgres
# DB_PASSWORD_FILE=/run/secrets/db-password

SESSION_LIFETIME=7200
