{% extends 'auth/layout.twig' %}

{% block title %}Login | Template Admin{% endblock %}

{% block content %}
<div class="auth-shell">
    <section class="auth-visual" aria-hidden="true">
        <div class="auth-visual__brand">
            <img src="/assets/brand/brayan-logo.png" alt="" width="36" height="36">
            <span>Template Admin</span>
        </div>
        <div class="auth-visual__copy">
            <h1>Painel administrativo</h1>
            <p>Gerencie usuários, papéis e permissões em um sistema PHP com Twig e PostgreSQL.</p>
        </div>
        <p class="small mb-0" style="position:relative;z-index:1;color:#64748b;">PHP 8.5 · Twig · Bootstrap 6</p>
    </section>

    <section class="auth-panel">
        <div class="auth-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h2>Entrar</h2>
                    <p class="lead mb-0">Use suas credenciais para continuar.</p>
                </div>
                <button type="button" class="app-icon-btn" data-theme-toggle aria-label="Alternar tema" title="Alternar tema">
                    <i class="bi bi-moon-stars" data-theme-icon aria-hidden="true"></i>
                </button>
            </div>

            {% if error %}
            <div class="alert theme-danger d-flex align-items-start gap-2 mb-3" role="alert">
                <i class="bi bi-x-circle mt-1" aria-hidden="true"></i>
                <p class="mb-0">{{ error }}</p>
            </div>
            {% endif %}

            <form method="post" action="/login" class="vstack gap-3">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <div>
                    <label class="form-label" for="email">E-mail</label>
                    <input type="email" class="form-control" id="email" name="email" value="{{ email|default('admin@example.com') }}" required autofocus autocomplete="username">
                </div>
                <div>
                    <label class="form-label" for="password">Senha</label>
                    <input type="password" class="form-control" id="password" name="password" required autocomplete="current-password">
                </div>
                <button type="submit" class="btn-solid theme-primary w-100">Entrar</button>
            </form>

            <div class="auth-demo">
                Credenciais de demonstração<br>
                Login: <code class="font-mono">admin@example.com</code><br>
                Senha: <span id="demo-password-mask" class="font-mono" aria-live="polite">••••••••</span>
                <button type="button" class="btn-text theme-primary btn-sm p-0 ms-1 align-baseline" id="demo-password-toggle" data-password="admin123">Mostrar</button>
            </div>
        </div>
    </section>
</div>
{% endblock %}

{% block scripts %}
<script>
(function () {
    var btn = document.getElementById('demo-password-toggle');
    var mask = document.getElementById('demo-password-mask');
    if (!btn || !mask) return;
    btn.addEventListener('click', function () {
        var pwd = btn.getAttribute('data-password');
        if (btn.textContent === 'Mostrar') {
            mask.textContent = pwd;
            btn.textContent = 'Ocultar';
        } else {
            mask.textContent = '••••••••';
            btn.textContent = 'Mostrar';
        }
    });
})();
</script>
{% endblock %}
