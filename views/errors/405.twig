{% extends 'auth/layout.twig' %}

{% block title %}405 — Método não permitido | Template Admin{% endblock %}

{% block content %}
<div class="auth-error-page">
    <div class="auth-error-card">
        <div class="code">405</div>
        <h1 class="h4 mb-2">Método não permitido</h1>
        <p class="text-secondary mb-4">Esta rota não aceita o método HTTP usado.</p>
        <a href="/" class="btn-solid theme-primary">Ir para o início</a>
    </div>
</div>
{% endblock %}
