{% extends 'auth/layout.twig' %}

{% block title %}404 — Página não encontrada | Template Admin{% endblock %}

{% block content %}
<div class="auth-error-page">
    <div class="auth-error-card">
        <div class="code">404</div>
        <h1 class="h4 mb-2">Página não encontrada</h1>
        <p class="text-secondary mb-4">O endereço não existe ou foi movido.</p>
        <a href="/" class="btn-solid theme-primary">Ir para o início</a>
    </div>
</div>
{% endblock %}
