{% extends "layout.twig" %}
{% block title %}Perfis{% endblock %}
{% block page_title %}Perfis{% endblock %}
{% block breadcrumb_current %}Perfis{% endblock %}
{% block page_actions %}
{% if 'role.create' in permissions %}
<a href="/perfis/create" class="btn-solid theme-primary btn-sm app-btn-with-icon">
    <i class="bi bi-plus-lg" aria-hidden="true"></i>
    Novo perfil
</a>
{% endif %}
{% endblock %}
{% block content %}
<div class="app-table-wrap">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Slug</th>
                {% if 'role.edit' in permissions or 'role.delete' in permissions %}
                <th class="text-end">Ações</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
            {% for r in roles %}
            <tr>
                <td class="font-mono">{{ r.id }}</td>
                <td>{{ r.name }}</td>
                <td><code class="font-mono">{{ r.slug }}</code></td>
                {% if 'role.edit' in permissions or 'role.delete' in permissions %}
                <td class="text-end text-nowrap">
                    {% if 'role.edit' in permissions %}
                    <a href="/perfis/{{ r.id }}/edit" class="app-icon-btn app-icon-btn--accent" title="Editar perfil e permissões" aria-label="Editar {{ r.name }}">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </a>
                    {% endif %}
                    {% if 'role.delete' in permissions and r.slug != 'admin' %}
                    <form action="/perfis/{{ r.id }}/delete" method="post" class="d-inline" onsubmit="return confirm('Excluir este perfil?');">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <button type="submit" class="app-icon-btn app-icon-btn--danger" title="Excluir" aria-label="Excluir {{ r.name }}">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                    </form>
                    {% endif %}
                </td>
                {% endif %}
            </tr>
            {% else %}
            <tr>
                <td colspan="4" class="empty-state">Nenhum perfil cadastrado.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
