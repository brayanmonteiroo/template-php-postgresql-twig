<header class="app-header">
    <div class="d-flex align-items-center gap-1">
        <button
            type="button"
            class="app-icon-btn app-sidebar-toggle"
            data-bs-toggle="drawer"
            data-bs-target="#sidebarDrawer"
            aria-controls="sidebarDrawer"
            aria-label="Abrir menu"
        >
            <i class="bi bi-list" aria-hidden="true"></i>
        </button>
        <button
            type="button"
            class="app-icon-btn app-sidebar-collapse"
            data-sidebar-collapse
            aria-label="Recolher menu"
            title="Recolher / expandir menu"
        >
            <i class="bi bi-layout-sidebar-inset" data-sidebar-collapse-icon aria-hidden="true"></i>
        </button>
        <span class="md:d-none fw-semibold">Template Admin</span>
    </div>
    <div class="d-flex align-items-center gap-1">
        <button
            type="button"
            class="app-icon-btn"
            data-theme-toggle
            aria-label="Alternar tema"
            title="Alternar tema"
        >
            <i class="bi bi-moon-stars" data-theme-icon aria-hidden="true"></i>
        </button>
        <div>
            <button
                type="button"
                class="app-icon-btn"
                data-bs-toggle="menu"
                aria-expanded="false"
                aria-label="Menu do usuário"
                title="{{ user.name|default('Conta') }}"
            >
                <i class="bi bi-person-circle" aria-hidden="true"></i>
            </button>
            <div class="menu">
                <div class="menu-header px-3 py-2 small text-secondary">{{ user.name|default('') }}</div>
                <a class="menu-item" href="/profile">
                    <i class="bi bi-person menu-item-icon" aria-hidden="true"></i>
                    Perfil
                </a>
                <hr class="menu-divider">
                <button type="submit" form="logout-form" class="menu-item">
                    <i class="bi bi-box-arrow-right menu-item-icon" aria-hidden="true"></i>
                    Sair
                </button>
            </div>
        </div>
    </div>
    <form id="logout-form" action="/logout" method="post" class="d-none">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    </form>
</header>
