{% for type, list in flash_messages %}
{% set messages = list is iterable ? list : [list] %}
{% for text in messages %}
{% set variant = type == 'error' ? 'danger' : type %}
{% set icon = variant == 'success' ? 'bi-check-circle' : (variant == 'danger' ? 'bi-x-circle' : (variant == 'warning' ? 'bi-exclamation-triangle' : 'bi-info-circle')) %}
{% set title = variant == 'danger' ? 'Erro' : (variant == 'success' ? 'Sucesso' : (variant == 'warning' ? 'Atenção' : 'Informação')) %}
<div class="alert theme-{{ variant }} d-flex align-items-start gap-2 mb-3" role="alert">
    <i class="bi {{ icon }} mt-1" aria-hidden="true"></i>
    <div class="flex-grow-1">
        <strong class="d-block mb-1">{{ title }}</strong>
        <p class="mb-0">{{ text }}</p>
    </div>
    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Fechar"></button>
</div>
{% endfor %}
{% endfor %}
