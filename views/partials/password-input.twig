{#
  Campo de senha com botão mostrar/ocultar (Bootstrap Icons).

  {% include 'partials/password-input.twig' with {
      id: 'password',
      name: 'password',
      required: true,
      autocomplete: 'current-password',
      error: errors.password|default(null),
      minlength: 8
  } only %}
#}
{% set input_id = id|default('password') %}
{% set has_error = error is defined and error %}
<div class="app-password-field">
    <input
        type="password"
        class="form-control{{ has_error ? ' is-invalid' : '' }}"
        id="{{ input_id }}"
        name="{{ name|default('password') }}"
        {% if required|default(false) %}required{% endif %}
        minlength="{{ minlength|default(8) }}"
        autocomplete="{{ autocomplete|default('current-password') }}"
        {% if autofocus|default(false) %}autofocus{% endif %}
    >
    <button
        type="button"
        class="app-password-toggle"
        data-password-toggle
        aria-label="Mostrar senha"
        aria-controls="{{ input_id }}"
        title="Mostrar senha"
    >
        <i class="bi bi-eye" data-password-toggle-icon aria-hidden="true"></i>
    </button>
    {% if has_error %}
    <div class="invalid-feedback">{{ error }}</div>
    {% endif %}
</div>
