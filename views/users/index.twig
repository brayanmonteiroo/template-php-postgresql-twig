{% extends "layout.twig" %}
{% block title %}Usuários{% endblock %}
{% block page_title %}Usuários{% endblock %}
{% block breadcrumb_current %}Usuários{% endblock %}
{% block page_actions %}
{% if 'user.create' in permissions %}
<a href="/users/create" class="btn-solid theme-primary btn-sm app-btn-with-icon">
    <i class="bi bi-plus-lg" aria-hidden="true"></i>
    Novo usuário
</a>
{% endif %}
{% endblock %}
{% block content %}
{% embed 'partials/filter-bar.twig' with {
    action: '/users',
    clear_url: '/users',
    is_filtered: (search != '' or status != ''),
    search: search,
    status: status
} only %}
    {% block fields %}
    <div class="input-group app-filter-search">
        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
        <input type="text" name="search" class="form-control" placeholder="Buscar nome ou e-mail" value="{{ search|default('') }}">
    </div>
    <select name="status" class="form-control app-filter-select" aria-label="Status">
        <option value="">Todos os status</option>
        <option value="active" {{ status|default('') == 'active' ? 'selected' : '' }}>Ativo</option>
        <option value="inactive" {{ status|default('') == 'inactive' ? 'selected' : '' }}>Inativo</option>
    </select>
    {% endblock %}
{% endembed %}

<div class="app-table-wrap">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th><a href="?{{ build_query({page: 1, search: search, status: status, sort: 'id', order: (sort == 'id' and order == 'asc') ? 'desc' : 'asc'}) }}">ID</a></th>
                <th><a href="?{{ build_query({page: 1, search: search, status: status, sort: 'name', order: (sort == 'name' and order == 'asc') ? 'desc' : 'asc'}) }}">Nome</a></th>
                <th><a href="?{{ build_query({page: 1, search: search, status: status, sort: 'email', order: (sort == 'email' and order == 'asc') ? 'desc' : 'asc'}) }}">E-mail</a></th>
                <th><a href="?{{ build_query({page: 1, search: search, status: status, sort: 'status', order: (sort == 'status' and order == 'asc') ? 'desc' : 'asc'}) }}">Status</a></th>
                {% if 'user.edit' in permissions or 'user.delete' in permissions %}
                <th class="text-end">Ações</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
            {% for u in users %}
            <tr>
                <td class="font-mono">{{ u.id }}</td>
                <td>{{ u.name }}</td>
                <td>{{ u.email }}</td>
                <td>
                    <span class="badge badge-subtle theme-{{ u.status == 'active' ? 'success' : 'secondary' }}">
                        {{ u.status == 'active' ? 'Ativo' : (u.status == 'inactive' ? 'Inativo' : u.status) }}
                    </span>
                </td>
                {% if 'user.edit' in permissions or 'user.delete' in permissions %}
                <td class="text-end text-nowrap">
                    {% if 'user.edit' in permissions %}
                    <a href="/users/{{ u.id }}/edit" class="app-icon-btn app-icon-btn--accent" title="Editar" aria-label="Editar {{ u.name }}">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </a>
                    {% endif %}
                    {% if 'user.delete' in permissions %}
                    <form
                        action="/users/{{ u.id }}/delete"
                        method="post"
                        class="d-inline"
                        data-confirm
                        data-confirm-title="Excluir usuário"
                        data-confirm-message="Tem certeza que deseja excluir {{ u.name }}? Esta ação não pode ser desfeita."
                    >
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <button type="submit" class="app-icon-btn app-icon-btn--danger" title="Excluir" aria-label="Excluir {{ u.name }}">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                    </form>
                    {% endif %}
                </td>
                {% endif %}
            </tr>
            {% else %}
            <tr>
                <td colspan="5" class="empty-state">Nenhum usuário encontrado.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% if total > 0 %}
    <div class="app-table-footer">
        <span class="text-secondary small">Total: {{ total }} usuário(s)</span>
        {% if pages > 1 %}
        <nav aria-label="Paginação">
            <ul class="pagination pagination-sm mb-0">
                {% if current_page > 1 %}
                <li class="page-item"><a class="page-link" href="?{{ build_query({page: current_page - 1, search: search, status: status, sort: sort, order: order}) }}">Anterior</a></li>
                {% endif %}
                {% for p in 1..pages %}
                    {% if p == current_page %}
                <li class="page-item active"><span class="page-link">{{ p }}</span></li>
                    {% else %}
                <li class="page-item"><a class="page-link" href="?{{ build_query({page: p, search: search, status: status, sort: sort, order: order}) }}">{{ p }}</a></li>
                    {% endif %}
                {% endfor %}
                {% if current_page < pages %}
                <li class="page-item"><a class="page-link" href="?{{ build_query({page: current_page + 1, search: search, status: status, sort: sort, order: order}) }}">Próxima</a></li>
                {% endif %}
            </ul>
        </nav>
        {% endif %}
    </div>
    {% endif %}
</div>
{% endblock %}
