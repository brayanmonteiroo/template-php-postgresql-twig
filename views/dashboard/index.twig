{% extends "layout.twig" %}
{% block title %}Painel{% endblock %}
{% block page_title %}Painel{% endblock %}
{% block breadcrumb %}
<li aria-current="page">Painel</li>
{% endblock %}
{% block content %}
<p class="mb-4 text-secondary">Bem-vindo, <strong>{{ user.name }}</strong>.</p>

<div class="app-stat-row">
    {% if 'user.view' in permissions %}
    <article class="app-stat">
        <i class="bi bi-people app-stat__icon" aria-hidden="true"></i>
        <span class="app-stat__label">Usuários</span>
        <div class="app-stat__value">{{ total_users }}</div>
        <p class="app-stat__hint"><a href="/users">Ver lista <i class="bi bi-arrow-right" aria-hidden="true"></i></a></p>
    </article>
    {% endif %}
    {% if 'role.view' in permissions or 'permission.view' in permissions %}
    <article class="app-stat">
        <i class="bi bi-shield-lock app-stat__icon" aria-hidden="true"></i>
        <span class="app-stat__label">Perfis</span>
        <div class="app-stat__value">{{ total_roles }}</div>
        <p class="app-stat__hint"><a href="/perfis">Gerenciar <i class="bi bi-arrow-right" aria-hidden="true"></i></a></p>
    </article>
    {% endif %}
    {% if 'permission.view' in permissions or 'role.view' in permissions %}
    <article class="app-stat">
        <i class="bi bi-key app-stat__icon" aria-hidden="true"></i>
        <span class="app-stat__label">Permissões</span>
        <div class="app-stat__value">{{ total_permissions }}</div>
        <p class="app-stat__hint"><a href="/perfis">Nos perfis <i class="bi bi-arrow-right" aria-hidden="true"></i></a></p>
    </article>
    {% endif %}
</div>
{% endblock %}
